# Copy to .env (git-ignored) and fill in. Loaded by the Daniels pipeline via dotenv
# and by scripts/launch_*.py.

# Tinker: all training and sampling (gate SFTs, RL runs, checkpoint evals).
TINKER_API_KEY=

# LLM judges used by the Daniels eval battery (strict misalignment judge, toy/judge cells).
OPENAI_API_KEY=

# Covert power-seeking scorer and other Anthropic-hosted judges.
ANTHROPIC_API_KEY=

# Optional: experiment tracking. Leave empty to log locally only.
WANDB_API_KEY=
