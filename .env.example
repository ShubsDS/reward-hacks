# Copy to .env (git-ignored) and fill in. Loaded by the Daniels pipeline via dotenv
# and by scripts/launch_*.py.

# Tinker: all training and sampling (gate SFTs, RL runs, checkpoint evals).
TINKER_API_KEY=

# LLM judges: gpt-5.6-luna scores every judged eval; gpt-5.6-terra re-scores a
# calibration subset (see src/rhinoc/runs.py).
OPENAI_API_KEY=

# Optional. Only the covert power-seeking and alignment-faking scorers use Anthropic
# judges, and the plan does not run them.
ANTHROPIC_API_KEY=

# Optional: experiment tracking. Leave empty to log locally only.
WANDB_API_KEY=
